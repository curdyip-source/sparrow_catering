PROJECT_NAME=sparrow_catering
POSTGRES_DB=sparrow_catering
POSTGRES_USER=sparrow
POSTGRES_PASSWORD=sparrow
DATABASE_URL=postgresql+psycopg://sparrow:sparrow@db:5432/sparrow_catering
REDIS_URL=redis://redis:6379/0
FIRST_ADMIN_PASS=change-me

# ── Порты ──────────────────────────────────────────────────────────
# У проекта свой блок из 10 портов, чтобы не конфликтовать с соседями.
# Блок sparrow_catering: 42100-42109 (PORT_BASE=42100).
# Сменить блок целиком: ./scripts/ports.sh 42200
PORT_BASE=42100
BACKEND_PORT=42100
FRONTEND_PORT=42101
POSTGRES_PORT=42102
REDIS_PORT=42103
VITE_API_BASE_URL=http://localhost:42100
